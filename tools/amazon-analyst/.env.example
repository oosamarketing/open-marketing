# Everything is optional. With nothing set, `amazon-analyst search` and `keywords` still work
# (search-page floors + listing-copy keyword mining). Each block unlocks one more signal.

# --- Where data lives ---
# AMAZON_ANALYST_DATA_DIR=./data          # sqlite db, raw Brand Analytics reports, indexes
# AMAZON_ANALYST_OUTPUT_DIR=./output      # markdown reports

# --- Selling Partner API (private app, self-authorized in Seller Central → Apps & Services → Develop apps) ---
# Unlocks: catalog enrichment (brand / Best Sellers Rank / bullet points for ANY ASIN, no page scraping)
#          and Brand Analytics search-term ranks (needs Brand Registry + the Brand Analytics role on the app).
# SPAPI_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
# SPAPI_LWA_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxx
# SPAPI_REFRESH_TOKEN=Atzr|xxxxxxxx

# --- Amazon Ads API (approved Ads API developer app + a profile you can access) ---
# Unlocks: Amazon's own ranked keyword suggestions for any set of ASINs ("reverse ASIN"), your
#          search-term impression share/rank on each, and suggested bid ranges.
# ADS_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
# ADS_LWA_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxx
# ADS_REFRESH_TOKEN=Atzr|xxxxxxxx
# ADS_PROFILE_ID=1234567890            # the marketplace profile (Amazon-Advertising-API-Scope)
# ADS_REGION=NA                        # NA | EU | FE

# --- LLM competitive analysis (optional) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
